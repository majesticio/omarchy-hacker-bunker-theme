{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/omarchy/branding/about.txt",
    "color": { "1": "#56CBD0" },
    "padding": { "top": 1, "right": 5, "left": 1 }
  },
  "display": {
    "separator": "  ",
    "disableLinewrap": true,
    "color": {
      "keys": "#56CBD0",
      "title": "#F1D18A",
      "output": "#C9E5DF",
      "separator": "#49666A"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;215;183;110m┌─[ SECURE NODE // SYSTEM TELEMETRY ]───────────────┐"
    },
    { "type": "custom",   "key": "│ NODE",     "keyColor": "#56CBD0", "format": "ABYSS-01" },
    { "type": "os",       "key": "│ PLATFORM", "keyColor": "#56CBD0" },
    { "type": "kernel",   "key": "│ KERNEL",   "keyColor": "#56CBD0" },
    { "type": "wm",       "key": "│ COMPOSITOR", "keyColor": "#56CBD0" },
    { "type": "terminal", "key": "│ CONSOLE",  "keyColor": "#56CBD0" },
    { "type": "shell",    "key": "│ SHELL",    "keyColor": "#56CBD0" },
    { "type": "uptime",   "key": "│ SESSION",  "keyColor": "#75B58A" },
    { "type": "packages", "key": "│ PAYLOADS", "keyColor": "#75B58A" },
    {
      "type": "command",
      "key": "│ THEME",
      "keyColor": "#F1D18A",
      "text": "omarchy theme current"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;73;102;106m├─[ HARDWARE ENVELOPE ]─────────────────────────────┤"
    },
    { "type": "cpu",    "key": "│ PROCESSOR", "keyColor": "#398DA4", "showPeCoreCount": true },
    { "type": "gpu",    "key": "│ GRAPHICS",  "keyColor": "#398DA4", "detectionMethod": "pci", "format": "{name}" },
    { "type": "memory", "key": "│ MEMORY",    "keyColor": "#398DA4" },
    { "type": "disk",   "key": "│ STORAGE",   "keyColor": "#398DA4" },
    {
      "type": "custom",
      "format": "\u001b[38;2;215;183;110m└─ STATUS: NOMINAL // TRACE: /dev/null ──────────────┘"
    },
    "break"
  ]
}
